{
  "name": "pi-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi 运行时数据的只读本地看板（单用户、单机、仅 127.0.0.1）",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "next build",
    "start": "node tools/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "coverage": "node --test --experimental-test-coverage test/*.test.ts",
    "check": "npm test && npm run typecheck && npm run build",
    "accept": "node tools/acceptance/offline.mjs",
    "verify": "npm run check && npm run accept",
    "desktop:dev": "node tools/desktop/start.mjs --dev",
    "desktop:run": "node tools/desktop/start.mjs",
    "desktop:pack": "ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ npm --prefix desktop run pack",
    "desktop:dmg": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ npm --prefix desktop run dmg"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  }
}
